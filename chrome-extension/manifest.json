{
    "manifest_version": 3,
    "name": "LinkedIn Job Filter",
    "version": "1.0",
    "description": "Hide low-value jobs and score good matches.",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*"
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/jobs/search-results/*"
            ],
            "js": [
                "content/content.js"
            ]
        }
    ]
}